# ===== 模型 Provider 切换 =====
# 可选值：dashscope（默认，不填即可）/ openai / ollama
# dashscope 为正式评测口径；openai 通吃智谱、DeepSeek、中转站等兼容端点；ollama 为本地零成本通道
# 真实配置只写进 backend/.env（不入库），本文件是模板
MODEL_PROVIDER=

# ---- 模型思考流（qwen 系思考模型）----
# 思考流不进正文但按解码速度逐 token 生成（思考量大的轮次可到 30-50 秒），只为深度追问场景付出；
# 三值语义：false 全关（默认，兼容单模型环境）/ true 面试官全档开 / auto 按难度分档——MEDIUM、HARD 开，EASY 关
# 只对面试官角色生效，报告、压缩、路由、闲聊等辅助调用一律不思考
# LLM_THINKING=false

# ---- dashscope 路线（默认，正式评测口径）----
# 阿里云百炼 DashScope 模型 API 密钥，用于通义千问调用
DASHSCOPE_API_KEY=
# 主力模型，默认 qwen-plus
DASHSCOPE_MODEL=

# ---- openai 兼容路线（开发期主力）----
# 所选 OpenAI 兼容平台的 API 密钥
OPENAI_API_KEY=
# OpenAI 兼容端点，默认智谱；DeepSeek、硅基流动、中转站等改此值
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名按所选平台的模型列表填写
OPENAI_MODEL=glm-4-flash
# 快档模型：摘要路由简历JD解析等辅助调用，未配置回退上面的主档模型
OPENAI_MODEL_FAST=

# ---- ollama 路线（本地零成本冒烟）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- RAG 检索（步骤 2，均有代码默认值，可不填）----
# embedding 模型名：openai 与 dashscope 默认 text-embedding-v3（1024 维），ollama 默认 nomic-embed-text（768 维）
# 换 embedding 模型后 Milvus 集合维度会变，导入须加 --rebuild
# OPENAI_EMBEDDING_MODEL=text-embedding-v3
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Milvus 连接与集合名
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=question_bank

# ---- 管理端（2026-11-04 管理端登录）----
# ADMIN_USERNAME=admin 时启动自动播种内置管理员：登录页有管理端页签，
# 账号 admin 密码取 ADMIN_PASSWORD（默认 admin），幂等——缺则建、密码不符则重置
# 不配置则管理接口 404 零暴露；指向其他用户名则该普通用户持管理权，不播种不改其密码
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# ---- 服务端 TTS（2026-11-06 服务端 TTS 合成）----
# off 关闭：读题回落浏览器朗读；edge 走微软免费朗读通道（edge-tts 边车容器，已接入）
# 嗓音为微软神经嗓音名，默认晓晓 zh-CN-XiaoxiaoNeural（另可选云希/云扬）
# 容器编排内边车地址由 compose 注入 TTS_EDGE_URL，本机直跑后端时才需要配
# TTS_PROVIDER=edge
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_EDGE_URL=http://localhost:8000

# 本机 MySQL 账号密码（本机服务端口 3306；用容器 mysql 时改 MYSQL_URL 到 3308）
# 连接池大小，默认 10，50 并发压测定位出小池排队后上调（2026-11-02）
# MYSQL_POOL=10

MYSQL_USERNAME=root
MYSQL_PASSWORD=
# MYSQL_URL=jdbc:mysql://localhost:3306/interview?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# Redis 连接（本机 memurai 6379；用容器 redis 时改成 redis://localhost:6380）
# REDIS_URI=redis://localhost:6379


# ---- 账号认证（步骤 7）----
# 无需配置：注册登录在页面完成，会话令牌存 Redis 自动过期
