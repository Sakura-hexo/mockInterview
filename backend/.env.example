# ===== 模型 Provider 切换 =====
# 可选值：dashscope（默认，不填即可）/ openai / ollama
# dashscope 为正式评测口径；openai 通吃智谱、DeepSeek 等兼容端点；ollama 为本地零成本通道
MODEL_PROVIDER=

# ---- dashscope 路线（默认，正式评测口径）----
# 阿里云百炼 DashScope 模型 API 密钥，用于通义千问调用
DASHSCOPE_API_KEY=
# 主力模型，默认 qwen-plus
DASHSCOPE_MODEL=

# ---- openai 兼容路线（开发期主力：智谱开放平台）----
# 智谱 bigmodel.cn 控制台创建的 API 密钥
OPENAI_API_KEY=http://ddns.trdyun.xyz:10003/v1
# OpenAI 兼容端点，默认智谱；DeepSeek、硅基流动等其他兼容源改此值
OPENAI_BASE_URL=http://ddns.trdyun.xyz:10003/v1
# 链路验证用免费 glm-4-flash，要面试官质量换付费强档
OPENAI_MODEL=glm-5-3-260814

# ---- ollama 路线（本地零成本冒烟）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- 接口鉴权 ----
# REST 接口 Bearer 鉴权令牌，本地随机生成一串字符串即可
APP_TOKEN=
